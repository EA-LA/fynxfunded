+struct FundedOrderProgressView: View {
+    @AppStorage("settings.language") private var localizationSelection = "system"
+    @EnvironmentObject private var auth: AuthViewModel
+    let orderID: String
+    @State private var progress: FundedOrderProgressData?
+    @State private var ownerID = ""
+    @State private var busy = false
+    @State private var error: String?
+    @State private var generation = UUID()
+#if DEBUG
+    private var fixture: FundedOrderProgressData?
+    init(fixture: FundedOrderProgressData) { orderID = fixture.orderID; self.fixture = fixture }
+#endif
+    init(orderID: String) {
+        self.orderID = orderID
+#if DEBUG
+        fixture = nil
+#endif
+    }
+    private var current: FundedOrderProgressData? {
+#if DEBUG
+        if let fixture { return fixture }
+#endif
+        return ownerID == auth.user?.uid && progress?.orderID == orderID ? progress : nil
+    }
+    var body: some View {
+        let _ = localizationSelection
+        FundedPage(title: L.tr("Order status"), subtitle: L.tr("Track payment confirmation and trading-account setup separately.")) {
+            FundedCard(highlighted: true) {
+                Label(current.map { L.tr($0.title) } ?? L.tr("Check your order"), systemImage: current?.accountReady == true ? "checkmark.seal.fill" : "clock").font(.title3.bold())
+                if let current {
+                    Text(L.tr(current.message)).font(.subheadline)
+                    Text(orderID).font(.caption).foregroundStyle(.secondary).textSelection(.enabled)
+                }
+                if busy { ProgressView(L.tr("Checking order status…")) }
+                if let error { Text(error).font(.subheadline).foregroundStyle(.red) }
+                Button(L.tr("Refresh status")) { Task { await load() } }.disabled(busy).accessibilityIdentifier("funded.order.refresh")
+            }
+            if let current {
+                FundedCard {
+                    step("Payment confirmed", current.paymentConfirmed)
+                    Divider(); step("Challenge recorded", current.challengeID != nil && current.paymentConfirmed)
+                    Divider(); step("Trading account ready", current.accountReady)
+                }
+                Text(L.tr("Simulated trading environment. Account readiness does not confirm a live data feed.")).font(.footnote).foregroundStyle(.secondary)
+                Text(L.tr("Last checked") + ": " + FundedWorkspaceModel.date(current.checkedAt)).font(.caption).foregroundStyle(.secondary)
+                if current.accountReady, let challenge = current.challengeID {
+                    NavigationLink { FundedAccountDetail(accountID: challenge) } label: {
+                        FundedRow(title: L.tr("Open trading account"), icon: "arrow.up.right.square")
+                    }.buttonStyle(.plain).accessibilityIdentifier("funded.order.openAccount")
+                }
+            }
+            NavigationLink { FundedSupportView(initialSubject: L.tr("Account setup") + ": " + orderID) } label: {
+                FundedRow(title: L.tr("Contact support"), icon: "bubble.left", subtitle: L.tr("Include this order reference"))
+            }.buttonStyle(.plain).accessibilityIdentifier("funded.order.support")
+        }.task(id: (auth.user?.uid ?? "") + ":" + orderID) { await load() }
+            .onDisappear { generation = UUID(); progress = nil; ownerID = ""; busy = false }
+    }
+    private func step(_ title: String, _ complete: Bool) -> some View {
+        HStack(alignment: .top) {
+            Image(systemName: complete ? "checkmark.circle.fill" : "clock").foregroundStyle(complete ? FundedStyle.green : .secondary)
+            VStack(alignment: .leading, spacing: 3) {
+                Text(L.tr(title)).font(.subheadline)
+                Text(L.tr(complete ? "Complete" : ["payment_failed", "refunded", "account_unavailable"].contains(current?.state ?? "") ? "Not completed" : "Pending")).font(.caption).foregroundStyle(.secondary)
+            }
+        }.padding(.vertical, 5)
+    }
+    @MainActor private func load() async {
+#if DEBUG
+        if fixture != nil { return }
+#endif
+        guard let uid = auth.user?.uid else { progress = nil; ownerID = ""; return }
+        let request = UUID(); generation = request; busy = true; error = nil; progress = nil; ownerID = ""
+        defer { if generation == request { busy = false } }
+        do {
+            let data = try await FundedCustomerAPI.call("fundedOrderStatus", ["orderId": orderID])
+            try Task.checkCancellation()
+            let parsed = try FundedOrderProgressData(data, expectedOrderID: orderID)
+            guard generation == request, auth.user?.uid == uid else { return }
+            progress = parsed; ownerID = uid
+        } catch {
+            guard generation == request, !Task.isCancelled else { return }
+            self.error = L.tr("Order status could not be confirmed. Retry or contact support; do not pay again while the result is unclear.")
+        }
+    }
+}
