+final class FundedAccessParityChecks: XCTestCase {
+    private var access: [String: Any] { ["userId":"owner", "accountId":"account", "challengeId":"challenge", "environment":"simulated", "platform":"Platform", "server":"Demo", "login":"123", "password":"synthetic-only", "tradingUrl":"https://example.com/trade"] }
+    private var progress: [String: Any] { ["orderId":"order", "state":"account_pending", "title":"Account setup pending", "message":"Do not pay again.", "paymentConfirmed":true, "accountReady":false, "challengeId":"challenge", "checkedAt":"2026-10-14T12:00:00Z"] }
+    func testCredentialResponseRequiresExactOwnerAndBinding() throws {
+        let value = try FundedCredentialData.credentials(access, uid:"owner", accountID:"account", challengeID:"challenge")
+        XCTAssertEqual(value.password,"synthetic-only")
+        XCTAssertThrowsError(try FundedCredentialData.credentials(access,uid:"other",accountID:"account",challengeID:"challenge"))
+        XCTAssertThrowsError(try FundedCredentialData.credentials(access,uid:"owner",accountID:"previous-phase",challengeID:"challenge"))
+        XCTAssertThrowsError(try FundedCredentialData.credentials(access,uid:"owner",accountID:"account",challengeID:nil))
+    }
+    func testCredentialResponseRejectsIncompleteAndUnsafeAccess() {
+        for url in ["http://example.com", "javascript:alert(1)", "https://example.com?token=secret", "https://user:pass@example.com", "https://example.com#secret"] {
+            var record=access;record["tradingUrl"]=url
+            XCTAssertThrowsError(try FundedCredentialData.credentials(record,uid:"owner",accountID:"account",challengeID:"challenge"))
+        }
+        var missing=access;missing.removeValue(forKey:"password")
+        XCTAssertThrowsError(try FundedCredentialData.credentials(missing,uid:"owner",accountID:"account",challengeID:"challenge"))
+    }
+    func testPaymentConfirmationNeverBecomesAccountReadiness() throws {
+        let status=try FundedOrderProgressData(progress,expectedOrderID:"order")
+        XCTAssertTrue(status.paymentConfirmed);XCTAssertFalse(status.accountReady)
+        var inconsistent=progress;inconsistent["accountReady"]=true
+        XCTAssertThrowsError(try FundedOrderProgressData(inconsistent,expectedOrderID:"order"))
+    }
+    func testOrderResponseRejectsWrongReferenceAndUnknownState() {
+        XCTAssertThrowsError(try FundedOrderProgressData(progress,expectedOrderID:"other"))
+        var unknown=progress;unknown["state"]="success-from-browser"
+        XCTAssertThrowsError(try FundedOrderProgressData(unknown,expectedOrderID:"order"))
+        var refunded=progress;refunded["state"]="refunded"
+        XCTAssertThrowsError(try FundedOrderProgressData(refunded,expectedOrderID:"order"))
+    }
+}
