+/// Shared status contract returned by the same authenticated service as the website.
+struct FundedOrderProgressData {
+    let orderID: String
+    let state: String
+    let title: String
+    let message: String
+    let paymentConfirmed: Bool
+    let accountReady: Bool
+    let challengeID: String?
+    let checkedAt: String
+    init(_ data: [String: Any], expectedOrderID: String) throws {
+        let allowed = ["payment_pending", "payment_failed", "refunded", "account_pending", "provisioning", "provisioning_failed", "ready", "account_unavailable", "review_required"]
+        guard data["orderId"] as? String == expectedOrderID,
+              let state = data["state"] as? String, allowed.contains(state),
+              let title = data["title"] as? String, !title.isEmpty,
+              let message = data["message"] as? String, !message.isEmpty,
+              let paid = data["paymentConfirmed"] as? Bool,
+              let ready = data["accountReady"] as? Bool,
+              let checked = data["checkedAt"] as? String, !checked.isEmpty else { throw FundedCredentialError.malformed }
+        let challenge = data["challengeId"] as? String
+        guard !ready || (state == "ready" && paid && challenge?.isEmpty == false), state != "ready" || ready,
+              !["payment_failed", "refunded", "payment_pending"].contains(state) || !paid else { throw FundedCredentialError.malformed }
+        orderID = expectedOrderID; self.state = state; self.title = title; self.message = message
+        paymentConfirmed = paid; accountReady = ready; challengeID = challenge; checkedAt = checked
+    }
+}
